{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@v2/*": ["./src/*"],
      "@app/*": ["./app/*"],
      "@api/*": ["./app/api/*"],
      "@mock/*": ["./mock/*"],
      "@edge-functions/*": ["./stubs/edge-functions/*"],
      "@clera/auth": ["./stubs/clera-auth/index.ts"],
      "@clera/auth/client": ["./stubs/clera-auth/client.ts"],
      "@clera/auth/frontend-api": ["./stubs/clera-auth/frontend-api.ts"],
      "@clera/db/types": ["./stubs/clera-db-types.ts"],
      "@sentry/nextjs": ["./stubs/sentry.ts"],
      "@clera/shared-types/email-schema": ["./packages/shared-types/src/email-schema.ts"],
      "@clera/route-factory": ["./packages/route-factory/src/index.ts"],
      "@clera/shared-utils": ["./packages/shared-utils/src/index.ts"],
      "@clera/shared-types": ["./packages/shared-types/src/index.ts"],
      "@clera/shared-types/talent-preferences-constants": ["./packages/shared-types/src/talent-preferences-constants.ts"],
      "@clera/shared-types/workplace-type": ["./packages/shared-types/src/workplace-type.ts"],
      "@clera/posthog-events": ["./packages/posthog-events/src/index.ts"],
      "@clera/utm/browser": ["./packages/utm/src/browser/index.ts"]
    },
    "types": ["node"],
    "skipLibCheck": true,
    "allowJs": true,
    "strictNullChecks": true,
    "strict": false,
    "noImplicitAny": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "incremental": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "app/**/*.ts", "app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx", "mock/**/*.ts", "stubs/**/*.ts", "packages/**/*.ts", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules"]
}
